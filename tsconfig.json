{
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "types", "test"],
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "types",

    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "allowJs": true,
    "checkJs": false,
    "allowImportingTsExtensions": true,

    "declaration": true,
    "emitDeclarationOnly": true,

    "noEmitOnError": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "skipLibCheck": true
  }
}