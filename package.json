{
  "name": "mementus",
  "version": "0.14.0",
  "type": "module",
  "description": "Graph computing for JS applications",
  "repository": "git@github.com:fictive-io/mementus",
  "author": "Mark Rickerby",
  "license": "MIT",
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "npm run build:bundle && npm run build:compile",
    "build:bundle": "rollup -c",
    "build:compile": "tsc",
    "test": "ava --verbose 'test/**/*.test.{js,ts}'",
    "lint": "eslint src"
  },
  "ava": {
    "extensions": {
      "js": true,
      "ts": "module"
    },
    "nodeArguments": [
      "--import=tsx"
    ],
    "workerThreads": false
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@rollup/plugin-json": "^4.1.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^18.19.130",
    "ava": "^6.4.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "rollup": "^2.70.1",
    "rollup-plugin-terser": "7.0.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.0"
  },
  "module": "src/mementus.js",
  "main": "dist/mementus.bundle.cjs",
  "types": "types/mementus.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./src/mementus.js",
      "require": "./dist/mementus.bundle.cjs"
    },
    "./graph": "./src/graph.js",
    "./util/": "./src/util/",
    "./types/": "./types/"
  },
  "files": [
    "dist",
    "src",
    "types",
    "README.md",
    "LICENSE"
  ]
}
